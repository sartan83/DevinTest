{
  "name": "file-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI file organization agent for Windows (Electron + React + Python sidecar).",
  "author": "Simone Agazzi",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p tsconfig.electron.json && electron dist-electron/main.js",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "lint": "eslint --ext .ts,.tsx src electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package": "npm run build && electron-builder --win --x64",
    "start": "electron dist-electron/main.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.14.0",
    "@typescript-eslint/parser": "^7.14.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.0"
  },
  "build": {
    "appId": "com.sartan83.fileagent",
    "productName": "FileAgent",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist_sidecar",
        "to": "sidecar",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "FileAgent-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
